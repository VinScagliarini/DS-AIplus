{
  "$schema": "https://design-tokens.org/v1/schema.json",
  "name": "ai-plus-ecosystem",
  "description": "Tokens condivisi del design system AI+ Ecosystem (Logotel). Estratti dal pacchetto Illustrator AI+_ECOSYSTEM.ai.",
  "color": {
    "neutral": {
      "cream":      { "value": "#F7F6F3", "type": "color", "description": "Sfondo cream condiviso, top-left di tutti i badge brand" },
      "ink":        { "value": "#0F0418", "type": "color", "description": "Quasi-nero per testo principale e superfici dark" },
      "ink-soft":   { "value": "#1A0E2A", "type": "color", "description": "Plum-black per card su sfondo dark" },
      "ink-muted":  { "value": "#6B5B7A", "type": "color", "description": "Grigio caldo per testo secondario" },
      "white":      { "value": "#FFFFFF", "type": "color" },
      "black":      { "value": "#000000", "type": "color" }
    },
    "powered-by-logotel": {
      "value": "#000000",
      "type": "color",
      "description": "Marca utilizzata per la lockup 'powered by logotel' in basso ai badge"
    }
  },
  "typography": {
    "font-family": {
      "display":  { "value": "'MuseoModerno', system-ui, sans-serif", "type": "fontFamily", "description": "Headlines e wordmark" },
      "body":     { "value": "'Roboto', 'Myriad Pro', system-ui, sans-serif", "type": "fontFamily", "description": "Sub heads e paragrafi" },
      "mono":     { "value": "'JetBrains Mono', ui-monospace, monospace", "type": "fontFamily" }
    },
    "font-weight": {
      "light":     { "value": 300, "type": "fontWeight" },
      "regular":   { "value": 400, "type": "fontWeight" },
      "medium":    { "value": 500, "type": "fontWeight" },
      "semibold":  { "value": 600, "type": "fontWeight" },
      "bold":      { "value": 700, "type": "fontWeight" }
    },
    "scale": {
      "display":   { "value": "clamp(3rem, 6vw + 1rem, 6.5rem)",  "type": "fontSize", "description": "Hero headline" },
      "h1":        { "value": "clamp(2.25rem, 3.5vw + 1rem, 4rem)", "type": "fontSize" },
      "h2":        { "value": "clamp(1.75rem, 2vw + 1rem, 2.75rem)", "type": "fontSize" },
      "h3":        { "value": "clamp(1.25rem, 1vw + 1rem, 1.75rem)", "type": "fontSize" },
      "body":      { "value": "1rem", "type": "fontSize" },
      "small":     { "value": "0.875rem", "type": "fontSize" },
      "caption":   { "value": "0.75rem", "type": "fontSize" }
    },
    "line-height": {
      "tight":     { "value": 1.0, "type": "number", "description": "Per display headline MuseoModerno" },
      "snug":      { "value": 1.15, "type": "number" },
      "normal":    { "value": 1.45, "type": "number" },
      "relaxed":   { "value": 1.65, "type": "number" }
    },
    "letter-spacing": {
      "display":   { "value": "-0.02em", "type": "letterSpacing" },
      "body":      { "value": "0",       "type": "letterSpacing" },
      "label":     { "value": "0.08em",  "type": "letterSpacing" }
    }
  },
  "radius": {
    "card":         { "value": "1.75rem", "type": "borderRadius", "description": "Rounded square dei badge brand (~12% del lato)" },
    "pill":         { "value": "9999px",   "type": "borderRadius" },
    "swatch":       { "value": "1.25rem",  "type": "borderRadius" },
    "button":       { "value": "9999px",   "type": "borderRadius", "description": "Bottoni della brand sheet sono pill" }
  },
  "shadow": {
    "card-soft":   { "value": "0 6px 24px -8px rgba(15, 4, 24, 0.12), 0 2px 6px -2px rgba(15, 4, 24, 0.06)", "type": "shadow" },
    "card-glow":   { "value": "0 24px 60px -12px var(--brand-glow, rgba(0,0,0,0.15))", "type": "shadow", "description": "Ogni brand override --brand-glow con il proprio alone" }
  },
  "spacing": {
    "xs":  { "value": "0.25rem", "type": "spacing" },
    "sm":  { "value": "0.5rem",  "type": "spacing" },
    "md":  { "value": "1rem",    "type": "spacing" },
    "lg":  { "value": "1.5rem",  "type": "spacing" },
    "xl":  { "value": "2.5rem",  "type": "spacing" },
    "2xl": { "value": "4rem",    "type": "spacing" },
    "3xl": { "value": "6rem",    "type": "spacing" }
  },
  "gradient": {
    "badge": {
      "value": "linear-gradient(135deg, var(--brand-bg-start, #F7F6F3) 0%, var(--brand-bg-end, #F7F6F3) 100%)",
      "type": "gradient",
      "description": "Gradient diagonale 135° che caratterizza il badge AI+ di ogni brand. Override --brand-bg-end per ciascun brand."
    },
    "hero-fade": {
      "value": "linear-gradient(160deg, var(--brand-bg-start, #F7F6F3) 0%, var(--brand-soft, #F7F6F3) 60%, var(--brand) 100%)",
      "type": "gradient"
    }
  },
  "lockups": {
    "ai-plus": {
      "value": "AI+",
      "type": "string",
      "description": "Marker testuale sempre presente nei badge dell'ecosistema. Set in MuseoModerno SemiBold."
    },
    "powered-by-logotel": {
      "value": "powered by logotel",
      "type": "string",
      "description": "Lockup standard in basso a destra dei badge."
    }
  }
}
